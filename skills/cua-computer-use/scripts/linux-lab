#!/usr/bin/env bash
# Launch one Cua Lab host on the current DISPLAY.
set -euo pipefail
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
SKILL_DIR="$(cd "$SCRIPT_DIR/.." && pwd)"
LAB="$SKILL_DIR/fixtures/cua-lab"
export DISPLAY="${DISPLAY:-:1}"

usage() {
  echo "Usage: linux-lab {gtk|qt|webkit|electron|tauri}" >&2
  exit 2
}

host="${1:-}"
[ -n "$host" ] || usage

case "$host" in
  gtk)
    exec python3 "$LAB/gtk/cua-lab-gtk.py"
    ;;
  qt)
    exec python3 "$LAB/qt/cua-lab-qt.py"
    ;;
  webkit)
    export CUA_LAB_TITLE="${CUA_LAB_TITLE:-Cua Lab WebKit}"
    exec python3 "$LAB/webkit/cua-lab-webkit.py"
    ;;
  electron)
    cd "$LAB/electron"
    if [ ! -x node_modules/.bin/electron ]; then
      npm install --no-fund --no-audit electron@36.2.0 >&2
    fi
    exec ./node_modules/.bin/electron . --no-sandbox
    ;;
  tauri)
    bin="$LAB/tauri/src-tauri/target/release/cua-lab"
    if [ ! -x "$bin" ]; then
      echo "linux-lab: build Tauri first: (cd $LAB/tauri/src-tauri && cargo build --release)" >&2
      exit 1
    fi
    exec "$bin"
    ;;
  *) usage ;;
esac
